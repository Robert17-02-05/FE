# Environment variables — DO NOT commit .env.local to Git!
# Copy to .env.local and fill in real values.

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Internery
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── API proxy ──────────────────────────────────────────────────
# Base URL for the SvelteKit backend.
# Leave empty in production if the backend is on the same host.
# Used in next.config.ts rewrites and apiClient.ts.
BACKEND_URL=http://localhost:5173

# NEXT_PUBLIC_API_BASE_URL is intentionally left empty so the
# fetch-based apiClient uses the Next.js rewrite proxy (/api/*).
NEXT_PUBLIC_API_BASE_URL=

# ── Auth (better-auth) ─────────────────────────────────────────
# No secret needed here — auth is handled by the SvelteKit backend.
# The session cookie is set by better-auth on the backend.

# ── Upload ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Analytics ──────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
